{
  "name": "@traceguard/workflows",
  "version": "0.0.0",
  "private": true,
  "description": "Durable Temporal workflow worker for TraceGuard",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && node --watch dist/worker.js",
    "lint": "eslint .",
    "start": "node dist/worker.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@temporalio/worker": "1.20.3",
    "@temporalio/workflow": "1.20.3",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
