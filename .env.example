# Local-only values. Replace every production value through a secret manager.
TRACEGUARD_ENV=development
TRACEGUARD_LOG_LEVEL=debug

# Explicit local-development credentials. Never reuse outside local Compose.
POSTGRES_ADMIN_USER=traceguard_admin
POSTGRES_ADMIN_PASSWORD=traceguard-local-admin
TRACEGUARD_DATABASE_PASSWORD=traceguard-local-app
TEMPORAL_DATABASE_PASSWORD=traceguard-local-temporal
KEYCLOAK_DATABASE_PASSWORD=traceguard-local-keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=traceguard-local-idp
MINIO_ROOT_USER=traceguard-local-storage
MINIO_ROOT_PASSWORD=traceguard-local-storage-secret

# Host ports may be overridden when they conflict with other local services.
KEYCLOAK_PORT=8081
TEMPORAL_UI_PORT=8082
MAILPIT_UI_PORT=8025
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# Browser-visible base URL for the public Express API.
NEXT_PUBLIC_TRACEGUARD_API_URL=http://localhost:4000
WEB_PORT=3000
