{
  "name": "@traceguard/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible shared UI components for TraceGuard",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
